{
  "version": "2.0.0",
  "title": "QuanV1 Multi-Backend Quantum Inference Registry",
  "description": "Full registry of all supported quantum backends with capabilities, routing rules, and real-time metrics for parallel/series pipeline orchestration",
  "routing_strategy": {
    "default": "best_fidelity",
    "options": ["best_fidelity", "lowest_latency", "lowest_cost", "most_qubits", "all_parallel", "round_robin"],
    "auto_rules": [
      { "condition": "circuit.two_qubit_gates > 10 AND circuit.qubits <= 25", "recommend": "ionq_aria", "reason": "All-to-all connectivity eliminates SWAP overhead; high 2Q fidelity" },
      { "condition": "circuit.qubits > 50", "recommend": "ibm_eagle_or_heron", "reason": "Largest available qubit counts" },
      { "condition": "algorithm == 'vqe' OR algorithm == 'qaoa'", "recommend": "pennylane_default", "reason": "Native autodiff gradient support; parameter-shift rule built-in" },
      { "condition": "circuit.depth < 5 AND circuit.qubits <= 20", "recommend": "all_parallel", "reason": "Low depth circuits are cheap — run all backends for statistical comparison" },
      { "condition": "algorithm == 'qec'", "recommend": "ibm_heron", "reason": "Lowest reported error rates; compatible with surface code layout" },
      { "condition": "circuit.requires_mid_circuit_measurement == true", "recommend": "ionq_aria OR ibm_heron", "reason": "Not all backends support mid-circuit measurement" },
      { "condition": "budget == 'free'", "recommend": "pennylane_lightning_qubit OR ibm_free_tier", "reason": "Local simulation and free cloud quota" }
    ]
  },
