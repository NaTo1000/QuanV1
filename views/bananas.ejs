<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🍌 Bananas AI — Your Fun Friend!</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/bananas.css">
</head>
<body class="bananas-page">

  <!-- Navigation Bar -->
  <nav class="main-nav">
    <div class="nav-container">
      <h1 class="nav-title">QuanV1 - Arkitek Builder</h1>
      <ul class="nav-menu">
        <li><a href="/" class="nav-link" accesskey="h">🏠 Home</a></li>
        <li><a href="/cluster-config" class="nav-link" accesskey="c">⚙️ Clusters</a></li>
        <li><a href="/ipxe-boot" class="nav-link" accesskey="b">🚀 Boot Generator</a></li>
        <li><a href="/system-info" class="nav-link" accesskey="s">💻 System</a></li>
        <li><a href="/quantum-school" class="nav-link">🎓 School</a></li>
        <li><a href="/quantum-analyzer" class="nav-link">🔬 Analyzer</a></li>
        <li><a href="/quantum-pipeline" class="nav-link">🔗 Pipeline</a></li>
        <li><a href="/quantum-rag-vault" class="nav-link">🔐 Vault</a></li>
        <li><a href="/quantum-vortex" class="nav-link">🌀 Vortex</a></li>
        <li><a href="/nvidia-pipeline" class="nav-link">🟢 NVIDIA</a></li>
        <li><a href="/bananas" class="nav-link nav-banana active">🍌 Bananas AI</a></li>
      </ul>
    </div>
  </nav>

  <div class="bananas-layout">

    <!-- ── SETUP SCREEN ──────────────────────────────────────── -->
    <div id="setupScreen" class="bananas-setup">
      <div style="font-size:5rem;margin-bottom:12px;">🍌</div>
      <h2>Hi there! I'm Bananas!</h2>
      <p>I'm your fun AI friend! Before we start, tell me a little about you 😊</p>
      <form class="setup-form" id="setupForm" onsubmit="startBananas(event)">
        <label for="kidName">What's your name?</label>
        <input type="text" id="kidName" placeholder="Type your name here..." maxlength="30" required autocomplete="off">
        <label for="kidAge">How old are you?</label>
        <select id="kidAge" required>
          <option value="" disabled selected>Pick your age group</option>
          <option value="young">5 – 7 years old</option>
          <option value="middle">8 – 10 years old</option>
          <option value="older">11 – 13 years old</option>
        </select>
        <button type="submit" class="btn-start">Let's Go! 🍌🎉</button>
      </form>
    </div>

    <!-- ── MAIN APP (hidden until setup) ─────────────────────── -->
    <div id="mainApp" style="display:none;">

      <!-- Avatar + Speech Bubble -->
      <div class="avatar-container">
        <div class="banana-avatar" id="bananasAvatar" onclick="avatarClicked()" title="Click me!">
          <svg class="banana-svg" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" aria-label="Bananas AI avatar">
            <!-- Body -->
            <ellipse cx="60" cy="72" rx="34" ry="38" fill="#FFD700"/>
            <!-- Belly -->
            <ellipse cx="60" cy="78" rx="22" ry="26" fill="#FFF176"/>
            <!-- Head -->
            <circle cx="60" cy="36" r="28" fill="#FFD700"/>
            <!-- Ears -->
            <ellipse cx="32" cy="36" rx="8" ry="11" fill="#FFD700"/>
            <ellipse cx="88" cy="36" rx="8" ry="11" fill="#FFD700"/>
            <!-- Eyes (white) -->
            <ellipse cx="50" cy="32" rx="8" ry="9" fill="#fff"/>
            <ellipse cx="70" cy="32" rx="8" ry="9" fill="#fff"/>
            <!-- Pupils -->
            <circle id="leftPupil"  cx="51" cy="33" r="4.5" fill="#2C3E50"/>
            <circle id="rightPupil" cx="71" cy="33" r="4.5" fill="#2C3E50"/>
            <!-- Eye shine -->
            <circle cx="53" cy="31" r="1.5" fill="#fff"/>
            <circle cx="73" cy="31" r="1.5" fill="#fff"/>
            <!-- Nose -->
            <ellipse cx="60" cy="41" rx="4" ry="3" fill="#FFC200"/>
            <!-- Mouth (smile) -->
            <path id="avatarMouth" d="M 50 50 Q 60 60 70 50" fill="none" stroke="#2C3E50" stroke-width="3" stroke-linecap="round"/>
            <!-- Cheeks -->
            <ellipse cx="40" cy="46" rx="7" ry="5" fill="#FFB3B3" opacity="0.5"/>
            <ellipse cx="80" cy="46" rx="7" ry="5" fill="#FFB3B3" opacity="0.5"/>
            <!-- Banana peel hair -->
            <path d="M 42 12 Q 38 2 48 8" fill="#FFC200" stroke="#E6AC00" stroke-width="1"/>
            <path d="M 60 8  Q 60 -2 60 6" fill="#FFC200" stroke="#E6AC00" stroke-width="1"/>
            <path d="M 78 12 Q 82 2 72 8" fill="#FFC200" stroke="#E6AC00" stroke-width="1"/>
            <!-- Arms -->
            <ellipse cx="26" cy="75" rx="7" ry="18" fill="#FFD700" transform="rotate(-20 26 75)"/>
            <ellipse cx="94" cy="75" rx="7" ry="18" fill="#FFD700" transform="rotate(20 94 75)"/>
            <!-- Legs -->
            <ellipse cx="47" cy="108" rx="8" ry="14" fill="#FFD700" transform="rotate(-8 47 108)"/>
            <ellipse cx="73" cy="108" rx="8" ry="14" fill="#FFD700" transform="rotate(8 73 108)"/>
          </svg>
        </div>
        <div class="avatar-name">🍌 Bananas</div>
        <div class="speech-bubble" id="speechBubble">
          Hi! I'm loading... just a sec! 🍌
        </div>
        <div class="stars-display" id="starsDisplay"></div>
      </div>

      <!-- Tab navigation -->
      <div class="bananas-tabs">
        <button class="tab-btn active" onclick="switchTab('jokes',   this)">😂 Jokes</button>
        <button class="tab-btn"        onclick="switchTab('games',   this)">🎮 Games</button>
        <button class="tab-btn"        onclick="switchTab('shows',   this)">📺 Shows</button>
      </div>

      <!-- ── JOKES TAB ───────────────────────────────────────── -->
      <div id="tab-jokes" class="tab-content">
        <div class="bananas-panel">
          <h3>😂 Joke Time!</h3>
          <div class="joke-card" id="jokeCard">
            <div class="joke-setup" id="jokeSetup">Press the button below to hear my first joke! 🍌</div>
            <div class="joke-punchline" id="jokePunchline"></div>
          </div>
          <div style="text-align:center;">
            <button class="btn-reveal" id="revealBtn" onclick="revealPunchline()" style="display:none;">
              Show me the punchline! 🥁
            </button>
            <br>
            <button class="btn-joke" onclick="nextJoke()">
              Tell me a joke! 🍌
            </button>
          </div>
        </div>
      </div>

      <!-- ── GAMES TAB ───────────────────────────────────────── -->
      <div id="tab-games" class="tab-content" style="display:none;">
        <div class="bananas-panel">
          <h3>🎮 Let's Play!</h3>
          <div class="game-selector">
            <div class="game-tile active" id="tile-guess_number" onclick="selectGame('guess_number', this)">
              <span class="game-tile-emoji">🔢</span>
              <span class="game-tile-name">Guess My<br>Number!</span>
            </div>
            <div class="game-tile" id="tile-animal_quiz" onclick="selectGame('animal_quiz', this)">
              <span class="game-tile-emoji">🐾</span>
              <span class="game-tile-name">Animal<br>Sounds!</span>
            </div>
            <div class="game-tile" id="tile-memory_match" onclick="selectGame('memory_match', this)">
              <span class="game-tile-emoji">🃏</span>
              <span class="game-tile-name">Memory<br>Match!</span>
            </div>
          </div>
          <div class="game-area" id="gameArea">
            <!-- Populated by JS -->
          </div>
        </div>
      </div>

      <!-- ── SHOWS TAB ───────────────────────────────────────── -->
      <div id="tab-shows" class="tab-content" style="display:none;">
        <div class="bananas-panel">
          <h3>📺 What shall we watch?</h3>
          <div class="category-grid" id="categoryGrid">
            <!-- Populated by JS -->
          </div>
          <div id="episodeSection" style="display:none;">
            <h3 id="episodeListTitle">Choose an episode:</h3>
            <div class="episode-list" id="episodeList"></div>
            <div id="episodeViewer" style="display:none;" class="episode-viewer">
              <div class="episode-title" id="epTitle"></div>
              <div class="episode-summary" id="epSummary"></div>
              <div class="fun-fact-box" id="epFunFact"></div>
              <div class="question-box" id="questionBox" style="display:none;">
                <div class="question-text"  id="questionText"></div>
                <div class="question-options" id="questionOptions"></div>
                <button class="btn-next-question" id="nextQBtn" onclick="nextQuestion()" style="display:none;">
                  Next Question ➡️
                </button>
              </div>
              <button class="btn-next-question" onclick="startQuestions()" id="startQBtn">
                🍌 Bananas has a question for you!
              </button>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /mainApp -->
  </div><!-- /bananas-layout -->

  <!-- Confetti container -->
  <div class="confetti" id="confettiContainer"></div>

<script>
// ═══════════════════════════════════════════════════════════════
// DATA (embedded from server)
// ═══════════════════════════════════════════════════════════════
const JOKES   = <%- JSON.stringify(jokes) %>;
const CONTENT = <%- JSON.stringify(content) %>;
const GAMES   = <%- JSON.stringify(games) %>;

// ═══════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════
let profile = { name: 'Friend', age: 'middle' };
let stars   = 0;
let currentJokeIdx     = -1;
let currentGame        = 'guess_number';
let numberGameSecret   = 0;
let numberGameAttempts = 0;
const NUMBER_GAME_MAX  = 5;
let animalIdx     = 0;
let animalShuffled = [];
let animalScore   = 0;
let memoryFlipped  = [];
let memoryMatched  = 0;
let memoryLocked   = false;
let memoryCards    = [];
let currentCategory = null;
let currentEpisode  = null;
let currentQIdx     = 0;

// ═══════════════════════════════════════════════════════════════
// SETUP
// ═══════════════════════════════════════════════════════════════
function startBananas(e) {
  e.preventDefault();
  profile.name = document.getElementById('kidName').value.trim() || 'Friend';
  profile.age  = document.getElementById('kidAge').value;
  localStorage.setItem('bananasProfile', JSON.stringify(profile));

  document.getElementById('setupScreen').style.display = 'none';
  document.getElementById('mainApp').style.display     = 'block';

  speak(`Hi ${profile.name}! I'm SO happy you're here! 🍌 What do you want to do first? Tell me — jokes, games, or shall we watch something together? 😊`);
  buildCategoryGrid();
  initGame('guess_number');
}

window.addEventListener('load', () => {
  const saved = localStorage.getItem('bananasProfile');
  if (saved) {
    try {
      profile = JSON.parse(saved);
      document.getElementById('setupScreen').style.display = 'none';
      document.getElementById('mainApp').style.display     = 'block';
      speak(`Welcome back, ${profile.name}! 🍌 I missed you! What shall we do today?`);
      buildCategoryGrid();
      initGame('guess_number');
    } catch {}
  }
});

// ═══════════════════════════════════════════════════════════════
// AVATAR / SPEECH
// ═══════════════════════════════════════════════════════════════
let speechTimer = null;
function speak(msg) {
  const bubble  = document.getElementById('speechBubble');
  const avatar  = document.getElementById('bananasAvatar');
  bubble.textContent = msg;
  avatar.classList.add('talking');
  clearTimeout(speechTimer);
  const duration = Math.max(2000, msg.length * 45);
  speechTimer = setTimeout(() => avatar.classList.remove('talking'), duration);
}

function celebrate() {
  addStar();
  const avatar = document.getElementById('bananasAvatar');
  avatar.classList.remove('celebrating');
  void avatar.offsetWidth;
  avatar.classList.add('celebrating');
  launchConfetti();
  setTimeout(() => avatar.classList.remove('celebrating'), 2000);
}

function avatarClicked() {
  const phrases = [
    `You're doing AMAZING, ${profile.name}! 🍌⭐`,
    "I love spending time with you! 😊",
    "You make me so happy! 🎉",
    "Did you know bananas are actually berries? 🍌😲",
    "You're my favourite! Shhhh, don't tell the others! 🤫",
    "Keep being awesome! ⭐",
    "Bananas are full of potassium — they help keep you strong! 💪"
  ];
  speak(phrases[Math.floor(Math.random() * phrases.length)]);
}

// ═══════════════════════════════════════════════════════════════
// STARS
// ═══════════════════════════════════════════════════════════════
function addStar() {
  stars++;
  const el = document.getElementById('starsDisplay');
  el.textContent = '⭐'.repeat(Math.min(stars, 10)) + (stars > 10 ? ` +${stars - 10} more!` : '');
}

// ═══════════════════════════════════════════════════════════════
// TABS
// ═══════════════════════════════════════════════════════════════
function switchTab(tab, btn) {
  document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
  document.querySelectorAll('.tab-btn').forEach(b  => b.classList.remove('active'));
  document.getElementById('tab-' + tab).style.display = 'block';
  btn.classList.add('active');
  if (tab === 'jokes') speak(`Let's laugh together, ${profile.name}! Click "Tell me a joke"! 😂`);
  if (tab === 'games') speak(`Game time! Pick a game and let's play! 🎮`);
  if (tab === 'shows') speak(`What shall we watch today? Pick a category! 📺`);
}

// ═══════════════════════════════════════════════════════════════
// JOKES
// ═══════════════════════════════════════════════════════════════
function filteredJokes() {
  return JOKES.jokes.filter(j => j.ageGroup === 'all' || j.ageGroup === profile.age);
}

function nextJoke() {
  const pool  = filteredJokes();
  let idx = Math.floor(Math.random() * pool.length);
  while (idx === currentJokeIdx && pool.length > 1) idx = Math.floor(Math.random() * pool.length);
  currentJokeIdx = idx;
  const joke = pool[idx];

  document.getElementById('jokeSetup').textContent    = joke.setup;
  document.getElementById('jokePunchline').textContent = joke.punchline;
  document.getElementById('jokePunchline').classList.remove('revealed');
  document.getElementById('revealBtn').style.display  = 'inline-block';
  speak("Here's my joke! Are you ready for the punchline? 🥁");
}

function revealPunchline() {
  document.getElementById('jokePunchline').classList.add('revealed');
  document.getElementById('revealBtn').style.display = 'none';
  const reactions = ["Ha ha ha! 😂🍌", "Did that make you smile? 😁", "I love that one! 🤣", "You're laughing, I can tell! 😄"];
  speak(reactions[Math.floor(Math.random() * reactions.length)]);
}

// ═══════════════════════════════════════════════════════════════
// GAMES
// ═══════════════════════════════════════════════════════════════
function selectGame(id, tile) {
  document.querySelectorAll('.game-tile').forEach(t => t.classList.remove('active'));
  tile.classList.add('active');
  currentGame = id;
  initGame(id);
}

function initGame(id) {
  const area = document.getElementById('gameArea');
  if (id === 'guess_number') initGuessNumber(area);
  if (id === 'animal_quiz')  initAnimalQuiz(area);
  if (id === 'memory_match') initMemoryMatch(area);
}

/* ── Guess the Number ──────────────────────────────────── */
function initGuessNumber(area) {
  numberGameSecret   = Math.floor(Math.random() * 20) + 1;
  numberGameAttempts = 0;
  area.innerHTML = `
    <h4>🔢 I'm thinking of a number between 1 and 20!</h4>
    <div class="number-input-row">
      <input type="number" id="guessInput" min="1" max="20" placeholder="?" onkeydown="if(event.key==='Enter')submitGuess()">
      <button class="btn-guess" onclick="submitGuess()">Guess!</button>
    </div>
    <div class="attempts-bar" id="attemptsDots">
      ${Array.from({length: NUMBER_GAME_MAX}, () => '<div class="attempt-dot"></div>').join('')}
    </div>
    <div class="game-feedback" id="guessFeedback"></div>`;
  speak("I'm thinking of a number between 1 and 20! Can you guess it? You have 5 tries! 🔢");
}

function submitGuess() {
  const input = document.getElementById('guessInput');
  const val   = parseInt(input.value, 10);
  const fb    = document.getElementById('guessFeedback');
  if (!val || val < 1 || val > 20) { fb.textContent = 'Please enter a number between 1 and 20! 🍌'; fb.className = 'game-feedback negative'; return; }

  const g = GAMES.games.guess_number;
  numberGameAttempts++;
  // Update dots
  const dots = document.querySelectorAll('.attempt-dot');
  if (dots[numberGameAttempts - 1]) dots[numberGameAttempts - 1].classList.add('used');

  if (val === numberGameSecret) {
    fb.textContent = g.responses.correct[Math.floor(Math.random() * g.responses.correct.length)];
    fb.className = 'game-feedback positive';
    celebrate();
    speak(`${g.responses.correct[0]} You got it in ${numberGameAttempts} guess${numberGameAttempts > 1 ? 'es' : ''}! 🎉`);
    setTimeout(() => initGuessNumber(document.getElementById('gameArea')), 3000);
  } else if (numberGameAttempts >= NUMBER_GAME_MAX) {
    const msg = g.responses.gameOver[Math.floor(Math.random() * g.responses.gameOver.length)].replace('{number}', numberGameSecret);
    fb.textContent = msg;
    fb.className = 'game-feedback negative';
    speak(`${msg} Let's try again! 🍌`);
    setTimeout(() => initGuessNumber(document.getElementById('gameArea')), 3000);
  } else if (val > numberGameSecret) {
    const msg = g.responses.tooHigh[Math.floor(Math.random() * g.responses.tooHigh.length)];
    fb.textContent = msg;
    fb.className = 'game-feedback negative';
    speak(msg);
  } else {
    const msg = g.responses.tooLow[Math.floor(Math.random() * g.responses.tooLow.length)];
    fb.textContent = msg;
    fb.className = 'game-feedback negative';
    speak(msg);
  }
  input.value = '';
  input.focus();
}

/* ── Animal Quiz ─────────────────────────────────────── */
function initAnimalQuiz(area) {
  animalShuffled = [...GAMES.games.animal_quiz.animals].sort(() => Math.random() - 0.5);
  animalIdx = 0; animalScore = 0;
  renderAnimalQuestion(area);
  speak("Let's play Animal Sounds! Do you know what sound each animal makes? 🐾");
}

function renderAnimalQuestion(area) {
  const g = GAMES.games.animal_quiz;
  if (animalIdx >= animalShuffled.length) {
    area.innerHTML = `<div class="score-display">🎉 You finished! Score: ${animalScore}/${animalShuffled.length} ⭐</div>
      <button class="btn-new-game" onclick="initAnimalQuiz(document.getElementById('gameArea'))">Play Again 🔄</button>`;
    speak(`Wow ${profile.name}! You got ${animalScore} out of ${animalShuffled.length}! You're a real animal expert! 🐾⭐`);
    if (animalScore === animalShuffled.length) celebrate();
    return;
  }
  const animal = animalShuffled[animalIdx];
  area.innerHTML = `
    <h4>🐾 What sound does this animal make?</h4>
    <div class="animal-display">${animal.emoji}</div>
    <div class="animal-name-display">${animal.name}</div>
    <div class="quiz-options-grid">
      ${animal.options.map(opt => `<button class="quiz-option-btn" onclick="answerAnimal(this,'${escHtml(opt)}','${escHtml(animal.sound)}')">${escHtml(opt)}</button>`).join('')}
    </div>
    <div class="score-display">Score: ${animalScore} ⭐</div>`;
}

function answerAnimal(btn, chosen, correct) {
  document.querySelectorAll('.quiz-option-btn').forEach(b => b.disabled = true);
  const g = GAMES.games.animal_quiz;
  if (chosen === correct) {
    btn.classList.add('correct');
    animalScore++;
    const praise = g.praise[Math.floor(Math.random() * g.praise.length)];
    speak(praise);
    celebrate();
  } else {
    btn.classList.add('wrong');
    document.querySelectorAll('.quiz-option-btn').forEach(b => { if (b.textContent.trim() === correct) b.classList.add('correct'); });
    speak(g.encouragement[Math.floor(Math.random() * g.encouragement.length)]);
  }
  animalIdx++;
  setTimeout(() => renderAnimalQuestion(document.getElementById('gameArea')), 1800);
}

/* ── Memory Match ─────────────────────────────────────── */
function initMemoryMatch(area) {
  const symbols = [...GAMES.games.memory_match.cards, ...GAMES.games.memory_match.cards].sort(() => Math.random() - 0.5);
  memoryFlipped = []; memoryMatched = 0; memoryLocked = false;
  memoryCards = symbols.map((sym, i) => ({ id: i, sym, flipped: false, matched: false }));
  renderMemoryGrid(area);
  speak(`Memory time! Flip the cards and find all the matching pairs, ${profile.name}! 🃏`);
}

function renderMemoryGrid(area) {
  area.innerHTML = `
    <h4>🃏 Find all the matching pairs!</h4>
    <div class="memory-grid" id="memGrid">
      ${memoryCards.map((c, i) => `
        <button class="memory-card${c.flipped ? ' flipped' : ''}${c.matched ? ' matched' : ''}"
                id="mc-${i}" onclick="flipCard(${i})" aria-label="Card ${i+1}">
          <span class="memory-card-back">🍌</span>
          <span class="memory-card-face">${c.sym}</span>
        </button>`).join('')}
    </div>
    <div class="score-display" id="memScore">Pairs found: ${memoryMatched} / ${GAMES.games.memory_match.cards.length}</div>
    <button class="btn-new-game" onclick="initMemoryMatch(document.getElementById('gameArea'))">New Game 🔄</button>`;
}

function flipCard(idx) {
  if (memoryLocked) return;
  const card = memoryCards[idx];
  if (card.flipped || card.matched) return;
  card.flipped = true;
  const el = document.getElementById('mc-' + idx);
  el.classList.add('flipped');

  memoryFlipped.push(idx);
  if (memoryFlipped.length === 2) {
    memoryLocked = true;
    const [a, b] = memoryFlipped;
    if (memoryCards[a].sym === memoryCards[b].sym) {
      memoryCards[a].matched = memoryCards[b].matched = true;
      document.getElementById('mc-' + a).classList.add('matched');
      document.getElementById('mc-' + b).classList.add('matched');
      memoryMatched++;
      document.getElementById('memScore').textContent = `Pairs found: ${memoryMatched} / ${GAMES.games.memory_match.cards.length}`;
      speak(['Great match! 🎉', 'You found a pair! ⭐', 'Amazing memory! 🍌'][Math.floor(Math.random()*3)]);
      if (memoryMatched === GAMES.games.memory_match.cards.length) {
        celebrate();
        speak(`You found ALL the pairs, ${profile.name}! You have an incredible memory! 🎉🍌⭐`);
      }
      memoryFlipped = [];
      memoryLocked  = false;
    } else {
      setTimeout(() => {
        memoryCards[a].flipped = memoryCards[b].flipped = false;
        document.getElementById('mc-' + a).classList.remove('flipped');
        document.getElementById('mc-' + b).classList.remove('flipped');
        memoryFlipped = [];
        memoryLocked  = false;
      }, 1000);
    }
  }
}

// ═══════════════════════════════════════════════════════════════
// SHOWS / CONTENT
// ═══════════════════════════════════════════════════════════════
function buildCategoryGrid() {
  const grid = document.getElementById('categoryGrid');
  grid.innerHTML = CONTENT.categories.map(cat => `
    <div class="category-tile" style="background:${cat.color};" onclick="selectCategory('${cat.id}')">
      <span class="category-emoji">${cat.emoji}</span>
      <span class="category-name">${cat.name}</span>
    </div>`).join('');
}

function selectCategory(id) {
  currentCategory = CONTENT.categories.find(c => c.id === id);
  if (!currentCategory) return;
  // Highlight
  document.querySelectorAll('.category-tile').forEach(t => t.classList.remove('active'));
  event.currentTarget.classList.add('active');

  document.getElementById('episodeSection').style.display = 'block';
  document.getElementById('episodeListTitle').textContent = `${currentCategory.emoji} Choose an episode:`;
  const list = document.getElementById('episodeList');
  list.innerHTML = currentCategory.episodes.map(ep => `
    <button class="episode-btn" onclick="selectEpisode('${ep.id}', this)">
      📺 ${ep.title}
    </button>`).join('');
  document.getElementById('episodeViewer').style.display = 'none';
  speak(`Ooh, ${currentCategory.name}! Great choice! Pick an episode and we'll watch together! 📺`);
}

function selectEpisode(id, btn) {
  document.querySelectorAll('.episode-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentEpisode = currentCategory.episodes.find(e => e.id === id);
  currentQIdx    = 0;
  if (!currentEpisode) return;

  document.getElementById('epTitle').textContent   = currentEpisode.title;
  document.getElementById('epSummary').textContent = currentEpisode.summary;
  document.getElementById('epFunFact').innerHTML   = `<strong>🌟 Fun Fact!</strong> ${currentEpisode.funFact}`;
  document.getElementById('questionBox').style.display = 'none';
  document.getElementById('startQBtn').style.display   = 'inline-block';
  document.getElementById('nextQBtn').style.display    = 'none';
  document.getElementById('episodeViewer').style.display = 'block';

  speak(`Let's watch "${currentEpisode.title}" together! 🎬 Read along with me, then I'll ask you a question!`);
}

function startQuestions() {
  document.getElementById('startQBtn').style.display = 'none';
  currentQIdx = 0;
  showQuestion();
}

function showQuestion() {
  if (!currentEpisode || currentQIdx >= currentEpisode.questions.length) {
    document.getElementById('questionBox').style.display = 'none';
    speak(`You answered all the questions! You're SO smart, ${profile.name}! 🍌⭐⭐`);
    celebrate();
    return;
  }
  const q = currentEpisode.questions[currentQIdx];
  document.getElementById('questionBox').style.display = 'block';
  document.getElementById('questionText').textContent = q.text;
  document.getElementById('nextQBtn').style.display   = 'none';
  const opts = document.getElementById('questionOptions');
  opts.innerHTML = q.options.map(opt => `
    <button class="question-opt-btn" onclick="answerQuestion(this, '${escHtml(opt)}', '${escHtml(q.answer)}', '${escHtml(q.praise)}')">
      ${escHtml(opt)}
    </button>`).join('');
  speak(`Question time! ${q.text} 🤔`);
}

function answerQuestion(btn, chosen, correct, praise) {
  document.querySelectorAll('.question-opt-btn').forEach(b => b.disabled = true);
  if (chosen === correct) {
    btn.classList.add('correct-ans');
    speak(praise);
    celebrate();
  } else {
    btn.classList.add('wrong-ans');
    document.querySelectorAll('.question-opt-btn').forEach(b => {
      if (b.textContent.trim() === correct) b.classList.add('correct-ans');
    });
    speak(`Nearly! The answer was "${correct}" — but you're doing great! 💪🍌`);
  }
  currentQIdx++;
  if (currentQIdx < currentEpisode.questions.length) {
    document.getElementById('nextQBtn').style.display = 'inline-block';
  } else {
    setTimeout(() => {
      document.getElementById('questionBox').style.display = 'none';
      speak(`All done! You're incredible, ${profile.name}! Want to try another episode? 🎬`);
    }, 2000);
  }
}

function nextQuestion() {
  document.getElementById('nextQBtn').style.display = 'none';
  showQuestion();
}

// ═══════════════════════════════════════════════════════════════
// CONFETTI
// ═══════════════════════════════════════════════════════════════
function launchConfetti() {
  const container = document.getElementById('confettiContainer');
  const colours = ['#FFD700','#FF8C00','#4CAF50','#2196F3','#E91E63','#9C27B0','#F44336'];
  for (let i = 0; i < 40; i++) {
    const piece = document.createElement('div');
    piece.className = 'confetti-piece';
    piece.style.left     = Math.random() * 100 + 'vw';
    piece.style.background = colours[Math.floor(Math.random() * colours.length)];
    piece.style.animationDuration = (1.5 + Math.random() * 2) + 's';
    piece.style.animationDelay   = (Math.random() * 0.5) + 's';
    piece.style.width  = piece.style.height = (8 + Math.random() * 10) + 'px';
    container.appendChild(piece);
    piece.addEventListener('animationend', () => piece.remove());
  }
}

// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════
function escHtml(str) {
  return String(str).replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
</script>
</body>
</html>
