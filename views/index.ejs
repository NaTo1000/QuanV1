<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanV1 - Arkitek Builder Platform</title>
    <meta name="description" content="Cluster management and iPXE boot file generator with beautiful haiku poetry">
    <meta property="og:title" content="QuanV1 - Arkitek Builder Platform">
    <meta property="og:description" content="Manage cluster configurations and generate iPXE boot files">
    <meta property="og:type" content="website">
    <link rel="stylesheet" href="/css/main.css" type="text/css">
    <link rel="stylesheet" href="/css/pages.css" type="text/css">
  </head>
  <body>
    <!-- Floating Particles -->
    <div class="particles" aria-hidden="true">
      <span class="particle">💖</span>
      <span class="particle">✨</span>
      <span class="particle">💫</span>
      <span class="particle">🌟</span>
      <span class="particle">💕</span>
      <span class="particle">⭐</span>
      <span class="particle">💗</span>
      <span class="particle">✨</span>
      <span class="particle">💖</span>
      <span class="particle">🌸</span>
      <span class="particle">💫</span>
      <span class="particle">🌟</span>
    </div>

    <!-- Navigation Bar -->
    <nav class="main-nav">
      <div class="nav-container">
        <h1 class="nav-title">✨ QuanV1 - Arkitek Builder</h1>
        <ul class="nav-menu">
          <li><a href="/" class="nav-link active" accesskey="h">🏠 Home</a></li>
          <li><a href="/cluster-config" class="nav-link" accesskey="c">⚙️ Clusters</a></li>
          <li><a href="/ipxe-boot" class="nav-link" accesskey="b">🚀 Boot Generator</a></li>
          <li><a href="/system-info" class="nav-link" accesskey="s">💻 System</a></li>
                  <li><a href="/quantum-school" class="nav-link">🎓 School</a></li>
          <li><a href="/quantum-analyzer" class="nav-link">🔬 Analyzer</a></li>
          <li><a href="/quantum-pipeline" class="nav-link">🔗 Pipeline</a></li>
          <li><a href="/quantum-rag-vault" class="nav-link">🔐 Vault</a></li>
          <li><a href="/quantum-vortex" class="nav-link">🌀 Vortex</a></li>
        <li><a href="/nvidia-pipeline" class="nav-link">🟢 NVIDIA</a></li>
        <li><a href="/bananas" class="nav-link nav-banana">🍌 Bananas AI</a></li>
      </div>
    </nav>

    <!-- Hero Banner -->
    <div class="hero-banner">
      <div class="hero-content">
        <div class="hero-sparkle" aria-hidden="true">✨</div>
        <h1 class="hero-title">Welcome to Arkitek Builder</h1>
        <p class="hero-tagline">Built with 💖 for the builders, dreamers, and innovators</p>
        <p class="hero-subtitle">Orchestrate clusters, generate boot files, and let the quantum magic flow</p>
        <div class="hero-cta">
          <a href="/cluster-config" class="hero-btn hero-btn-primary">⚙️ Start Building</a>
          <a href="/quantum-school" class="hero-btn hero-btn-secondary">🎓 Learn Quantum</a>
        </div>
        <div class="hero-hearts" aria-hidden="true">
          <span class="heart-pulse">💗</span>
          <span class="heart-pulse" style="animation-delay:0.4s">💙</span>
          <span class="heart-pulse" style="animation-delay:0.8s">💛</span>
          <span class="heart-pulse" style="animation-delay:1.2s">💚</span>
          <span class="heart-pulse" style="animation-delay:1.6s">💜</span>
        </div>
      </div>
    </div>

    <div class="content-wrapper">
      
      <!-- Quick Start Guide -->
      <div class="quick-start">
        <h2>🎯 Quick Start Guide</h2>
        <div class="steps">
          <div class="step">
            <span class="step-number">1</span>
            <div class="step-content">
              <h3>Configure Clusters</h3>
              <p>Add your cluster endpoints in the Clusters section</p>
              <a href="/cluster-config" class="step-link">Go to Clusters →</a>
            </div>
          </div>
          <div class="step">
            <span class="step-number">2</span>
            <div class="step-content">
              <h3>Generate Boot Files</h3>
              <p>Create iPXE boot configurations for mass deployment</p>
              <a href="/ipxe-boot" class="step-link">Go to Boot Generator →</a>
            </div>
          </div>
          <div class="step">
            <span class="step-number">3</span>
            <div class="step-content">
              <h3>Deploy Servers</h3>
              <p>Use generated files to boot and configure your servers</p>
            </div>
          </div>
        </div>
      </div>
    
    <div class="cluster-status">
      <h3>🔗 Arkitek Builder - Cluster Status</h3>
      <% if (clusterLinks && clusterLinks.length > 0) { %>
        <p>Connected clusters: <span class="cluster-count"><%= clusterLinks.length %></span></p>
        <ul>
          <% clusterLinks.forEach(function(link) { %>
            <li>
              <strong><%= link.name %></strong>
              <% if (link.builderType === 'docker-cloud') { %>
                <span class="badge badge-docker">🐳 Docker Cloud</span>
              <% } else if (link.builderType === 'kubernetes') { %>
                <span class="badge badge-k8s">☸️ K8s</span>
              <% } else if (link.builderType === 'openshift') { %>
                <span class="badge badge-openshift">OpenShift</span>
              <% } else if (link.builderType === 'watsonx') { %>
                <span class="badge badge-watsonx">🤖 Watson X</span>
              <% } %>
              <br>
              <span class="cluster-link-endpoint"><%= link.endpoint %></span>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="no-cluster">No cluster links configured</p>
      <% } %>
      <a href="/cluster-config" class="btn-primary">⚙️ Configure Clusters</a>
      <a href="/ipxe-boot" class="btn-success">🚀 Generate Boot Files</a>
    </div>

    <!-- Watson X Orchestrator Section -->
    <div class="watson-section">
      <h2>🤖 Watson X Orchestrator Integration</h2>
      <p>Leverage IBM Watson X.ai for intelligent cluster orchestration and AI-powered deployment optimization</p>
      
      <div class="watson-content">
        <div class="watson-feature">
          <h3>🧠 AI-Powered Orchestration</h3>
          <p>Use Watson X to intelligently manage and optimize your cluster deployments with machine learning capabilities.</p>
          <ul>
            <li>Automated resource allocation</li>
            <li>Predictive scaling</li>
            <li>Intelligent load balancing</li>
          </ul>
        </div>
        
        <div class="watson-feature">
          <h3>📊 Real-time Analytics</h3>
          <p>Monitor cluster performance with Watson X analytics and get AI-driven insights for optimization.</p>
          <ul>
            <li>Performance metrics</li>
            <li>Cost optimization suggestions</li>
            <li>Anomaly detection</li>
          </ul>
        </div>
      </div>
      
      <div class="watson-actions">
        <a href="/cluster-config" class="watson-btn">Add Watson X Cluster</a>
        <a href="https://www.ibm.com/docs/en/watsonx" target="_blank" rel="noopener noreferrer" class="watson-btn">View Documentation</a>
      </div>
      
      <div class="watson-status" id="watsonStatus">
        <strong>Status:</strong> Ready to integrate Watson X Orchestrator. Add your Watson X endpoint in the Clusters section.
      </div>
    </div>
    
    <!-- Love Corner -->
    <div class="love-corner">
      <div class="love-corner-inner">
        <div class="love-badge" aria-hidden="true">💖</div>
        <h2 class="love-title">Made with Love, Powered by Vision</h2>
        <p class="love-message">Every line of code here is a small act of love — for the craft, for the community, and for the curious minds building the future. You matter. What you create matters. Keep going. 🌟</p>
        <div class="love-affirmations">
          <span class="affirmation">✨ You are amazing</span>
          <span class="affirmation">💡 You are creative</span>
          <span class="affirmation">🚀 You are unstoppable</span>
          <span class="affirmation">💖 You are loved</span>
        </div>
      </div>
    </div>

    <!-- Haiku Section -->
    <div class="haiku-section">
      <h2 class="haiku-heading">✨ Inspiration Corner ✨</h2>
      <p class="haiku-intro">A little poetry to spark your soul between deployments 🌸</p>
      <div class="haiku-grid">
        <% for(var i=0; i < haikus.length; i++) { %>
          <div class="haiku-item haiku-card">
            <div class="haiku-glow" aria-hidden="true"></div>
            <img class="mona-images" src="images/<%= haikus[i].image %>" alt="<%= haikus[i].text.split(',')[0] %>">
            <div class="haiku-containers">
              <p class="haikus"><%- haikus[i].text %></p>
            </div>
          </div>
        <% } %>
      </div>
    </div>
    
    <!-- Keyboard Shortcuts Help -->
    <div class="help-tip">
      <span class="help-icon" title="Keyboard Shortcuts: Alt+H (Home), Alt+C (Clusters), Alt+B (Boot Generator)">❓</span>
    </div>
    </div>
  </body>
</html>
