<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanV1 - Arkitek Builder Platform</title>
    <meta name="description" content="Cluster management and iPXE boot file generator with beautiful haiku poetry">
    <meta property="og:title" content="QuanV1 - Arkitek Builder Platform">
    <meta property="og:description" content="Manage cluster configurations and generate iPXE boot files">
    <meta property="og:type" content="website">
    <link rel="stylesheet" href="/css/main.css" type="text/css">
    <link rel="stylesheet" href="/css/pages.css" type="text/css">
  </head>
  <body>
    <h1>Haikus for Mona</h1>
    
    <div class="cluster-status">
      <h3>🔗 Arkitek Builder - Cluster Status</h3>
      <% if (clusterLinks && clusterLinks.length > 0) { %>
        <p>Connected clusters: <span class="cluster-count"><%= clusterLinks.length %></span></p>
        <ul>
          <% clusterLinks.forEach(function(link) { %>
            <li>
              <strong><%= link.name %></strong>
              <% if (link.builderType === 'docker-cloud') { %>
                <span class="badge badge-docker">🐳 Docker Cloud</span>
              <% } else if (link.builderType === 'kubernetes') { %>
                <span class="badge badge-k8s">☸️ K8s</span>
              <% } else if (link.builderType === 'openshift') { %>
                <span class="badge badge-openshift">OpenShift</span>
              <% } %>
              <br>
              <span class="cluster-link-endpoint"><%= link.endpoint %></span>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="no-cluster">No cluster links configured</p>
      <% } %>
      <a href="/cluster-config">Configure Cluster Links</a>
      <a href="/ipxe-boot" class="btn-success">🚀 Generate iPXE Boot Files</a>
    </div>
    
    <div>
      <% for(var i=0; i < haikus.length; i++) { %>
        <img class="mona-images" src="images/<%= haikus[i].image %>" alt="<%= haikus[i].text.split(',')[0] %>">
        <div class="haiku-containers">
          <p class="haikus"><%- haikus[i].text %></p>
        </div>
      <% } %>
    </div>
  </body>
</html>
