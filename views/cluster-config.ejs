<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cluster Link Configuration - Arkitek Builder</title>
    <meta name="description" content="Configure and manage cluster links for the Arkitek Builder platform">
    <link rel="stylesheet" href="/css/main.css" type="text/css">
    <link rel="stylesheet" href="/css/pages.css" type="text/css">
  </head>
  <body>
    <!-- Navigation Bar -->
    <nav class="main-nav">
      <div class="nav-container">
        <h1 class="nav-title">QuanV1 - Arkitek Builder</h1>
        <ul class="nav-menu">
          <li><a href="/" class="nav-link" accesskey="h">🏠 Home</a></li>
          <li><a href="/cluster-config" class="nav-link active" accesskey="c">⚙️ Clusters</a></li>
          <li><a href="/ipxe-boot" class="nav-link" accesskey="b">🚀 Boot Generator</a></li>
          <li><a href="/system-info" class="nav-link" accesskey="s">💻 System</a></li>
                  <li><a href="/quantum-school" class="nav-link">🎓 School</a></li>
          <li><a href="/quantum-analyzer" class="nav-link">🔬 Analyzer</a></li>
          <li><a href="/quantum-pipeline" class="nav-link">🔗 Pipeline</a></li>
          <li><a href="/quantum-rag-vault" class="nav-link">🔐 Vault</a></li>
          <li><a href="/quantum-vortex" class="nav-link">🌀 Vortex</a></li>
</ul>
      </div>
    </nav>

    <div class="container">
      <h1>⚙️ Cluster Link Configuration</h1>
      <p class="subtitle">Manage your cluster endpoints and credentials</p>
      
      <div id="message"></div>
      
      <h2>Add New Cluster Link</h2>
      <form id="clusterLinkForm">
        <div class="form-group">
          <label for="name">Link Name *</label>
          <input type="text" id="name" name="name" required placeholder="e.g., Production Cluster" autofocus>
          <small class="form-help">Choose a descriptive name for your cluster</small>
        </div>
        
        <div class="form-group">
          <label for="builderType">Builder Type</label>
          <select id="builderType" name="builderType">
            <option value="generic">Generic Cluster</option>
            <option value="docker-cloud">🐳 Docker Cloud Builder</option>
            <option value="kubernetes">☸️ Kubernetes</option>
            <option value="openshift">OpenShift</option>
            <option value="watsonx">🤖 Watson X Orchestrator</option>
          </select>
          <small class="form-help">Select the type of cluster or orchestrator you're using</small>
        </div>
        
        <div class="form-group">
          <label for="endpoint">Endpoint URL *</label>
          <input type="text" id="endpoint" name="endpoint" required placeholder="e.g., https://cluster.example.com:9092">
          <small class="form-help">The full URL including protocol and port</small>
        </div>
        
        <div class="form-group">
          <label for="credentials">Credentials (optional)</label>
          <textarea id="credentials" name="credentials" rows="3" placeholder="API key, token, or connection string"></textarea>
          <small class="form-help">Stored securely - never committed to version control</small>
        </div>
        
        <button type="submit">Add Cluster Link</button>
        <button type="button" onclick="document.getElementById('clusterLinkForm').reset()">Clear</button>
      </form>
      
      <h2>Existing Cluster Links</h2>
      <div style="margin-bottom: 10px; display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="test-btn" onclick="exportClusters()">📥 Export Config</button>
        <label style="display: inline-block; margin: 0;">
          <input type="file" id="importFile" accept=".json" style="display: none;" onchange="importClusters(this)">
          <span class="test-btn" style="cursor: pointer; display: inline-block; padding: 10px 20px; background-color: #28a745; color: white; border-radius: 4px;">📤 Import Config</span>
        </label>
      </div>
      <div id="clusterLinksList">
        <% if (clusterLinks && clusterLinks.length > 0) { %>
          <% clusterLinks.forEach(function(link) { %>
            <div class="cluster-link-item" data-id="<%= link.id %>">
              <div class="cluster-link-header">
                <div>
                  <div class="cluster-link-name"><%= link.name %></div>
                  <span class="status-badge status-<%= link.status %>"><%= link.status %></span>
                  <% if (link.builderType === 'docker-cloud') { %>
                    <span class="badge badge-docker">🐳 Docker Cloud</span>
                  <% } else if (link.builderType === 'kubernetes') { %>
                    <span class="badge badge-k8s">☸️ Kubernetes</span>
                  <% } else if (link.builderType === 'openshift') { %>
                    <span class="badge badge-openshift">OpenShift</span>
                  <% } else if (link.builderType === 'watsonx') { %>
                    <span class="badge badge-watsonx">🤖 Watson X</span>
                  <% } %>
                </div>
                <div>
                  <button class="test-btn" style="padding: 6px 12px; font-size: 13px;" onclick="editClusterLink('<%= link.id %>', '<%= link.name.replace(/\'/g, "\\x27") %>', '<%= link.endpoint.replace(/\'/g, "\\x27") %>', '<%= link.builderType %>')">Edit</button>
                  <button class="delete-btn" onclick="deleteClusterLink('<%= link.id %>')">Delete</button>
                </div>
              </div>
              <div class="cluster-link-endpoint"><strong>Endpoint:</strong> <%= link.endpoint %></div>
              <div style="color: #586069; font-size: 12px;">Created: <%= new Date(link.createdAt).toLocaleString() %></div>
            </div>
          <% }); %>
        <% } else { %>
          <p>No cluster links configured yet. Add one above to get started.</p>
        <% } %>
      </div>
    </div>

    <!-- Edit Cluster Modal -->
    <div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:2000; align-items:center; justify-content:center;">
      <div style="background:white; border-radius:8px; padding:30px; width:90%; max-width:500px; color:#24292e;">
        <h2 style="margin-top:0;">✏️ Edit Cluster Link</h2>
        <form id="editForm">
          <input type="hidden" id="editId">
          <div class="form-group">
            <label for="editName">Link Name *</label>
            <input type="text" id="editName" required>
          </div>
          <div class="form-group">
            <label for="editBuilderType">Builder Type</label>
            <select id="editBuilderType">
              <option value="generic">Generic Cluster</option>
              <option value="docker-cloud">🐳 Docker Cloud Builder</option>
              <option value="kubernetes">☸️ Kubernetes</option>
              <option value="openshift">OpenShift</option>
              <option value="watsonx">🤖 Watson X Orchestrator</option>
            </select>
          </div>
          <div class="form-group">
            <label for="editEndpoint">Endpoint URL *</label>
            <input type="text" id="editEndpoint" required>
          </div>
          <div class="form-group">
            <label for="editCredentials">Credentials (leave blank to keep existing)</label>
            <textarea id="editCredentials" rows="3" placeholder="Leave blank to keep existing credentials"></textarea>
          </div>
          <button type="submit">Save Changes</button>
          <button type="button" onclick="closeEditModal()" style="background:#6c757d;">Cancel</button>
        </form>
      </div>
    </div>

    <script>
      document.getElementById('clusterLinkForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = {
          name: document.getElementById('name').value,
          builderType: document.getElementById('builderType').value,
          endpoint: document.getElementById('endpoint').value,
          credentials: document.getElementById('credentials').value
        };
        
        try {
          const response = await fetch('/api/cluster-links', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
          });
          
          const data = await response.json();
          
          if (response.ok) {
            showMessage('Cluster link added successfully!', 'success');
            document.getElementById('clusterLinkForm').reset();
            setTimeout(() => location.reload(), 1000);
          } else {
            showMessage(data.error || 'Failed to add cluster link', 'error');
          }
        } catch (error) {
          showMessage('Error: ' + error.message, 'error');
        }
      });
      
      async function deleteClusterLink(id) {
        if (!confirm('Are you sure you want to delete this cluster link?')) {
          return;
        }
        
        try {
          const response = await fetch(`/api/cluster-links/${id}`, {
            method: 'DELETE'
          });
          
          if (response.ok) {
            showMessage('Cluster link deleted successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
          } else {
            const data = await response.json();
            showMessage(data.error || 'Failed to delete cluster link', 'error');
          }
        } catch (error) {
          showMessage('Error: ' + error.message, 'error');
        }
      }

      function editClusterLink(id, name, endpoint, builderType) {
        document.getElementById('editId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editEndpoint').value = endpoint;
        document.getElementById('editBuilderType').value = builderType;
        document.getElementById('editCredentials').value = '';
        document.getElementById('editModal').style.display = 'flex';
      }

      document.getElementById('editForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editId').value;
        const formData = {
          name: document.getElementById('editName').value,
          builderType: document.getElementById('editBuilderType').value,
          endpoint: document.getElementById('editEndpoint').value,
          credentials: document.getElementById('editCredentials').value
        };

        try {
          const response = await fetch(`/api/cluster-links/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
          });
          const data = await response.json();
          if (response.ok) {
            closeEditModal();
            showMessage('Cluster link updated successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
          } else {
            showMessage(data.error || 'Failed to update cluster link', 'error');
          }
        } catch (error) {
          showMessage('Error: ' + error.message, 'error');
        }
      });

      function closeEditModal() {
        document.getElementById('editModal').style.display = 'none';
      }

      async function exportClusters() {
        try {
          const response = await fetch('/api/cluster-links/export');
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'cluster-links-export.json';
          document.body.appendChild(a);
          a.click();
          window.URL.revokeObjectURL(url);
          document.body.removeChild(a);
        } catch (error) {
          showMessage('Export failed: ' + error.message, 'error');
        }
      }

      async function importClusters(input) {
        const file = input.files[0];
        if (!file) return;

        try {
          const text = await file.text();
          const links = JSON.parse(text);
          const payload = Array.isArray(links) ? links : links.links || [];

          const response = await fetch('/api/cluster-links/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ links: payload })
          });
          const data = await response.json();
          if (response.ok) {
            showMessage(`Import complete: ${data.added} added, ${data.skipped} skipped.`, 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            showMessage(data.error || 'Import failed', 'error');
          }
        } catch (error) {
          showMessage('Import error: ' + error.message, 'error');
        }
        input.value = '';
      }
      
      function showMessage(text, type) {
        const messageDiv = document.getElementById('message');
        messageDiv.className = 'message ' + type;
        messageDiv.textContent = text;
        messageDiv.style.display = 'block';
        
        setTimeout(() => {
          messageDiv.style.display = 'none';
        }, 5000);
      }
    </script>
  </body>
</html>
