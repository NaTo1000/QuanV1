<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quantum School — QuanV1</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    :root { --bg:#0a0a1a; --panel:#111128; --border:#2a2a4a; --text:#e2e8f0; --accent:#7c3aed; }
    body { background:var(--bg); color:var(--text); font-family:'Segoe UI',sans-serif; margin:0; }
    .school-layout { max-width:1400px; margin:0 auto; padding:24px 20px; }
    /* Stage selector */
    .stages { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:28px; }
    .stage-btn { padding:10px 18px; border-radius:8px; border:1px solid var(--border); background:var(--panel); color:var(--text); cursor:pointer; font-size:13px; transition:all .2s; }
    .stage-btn:hover, .stage-btn.active { background:var(--accent); border-color:var(--accent); }
    .stage-btn.locked { opacity:.35; cursor:not-allowed; }
    /* Concept grid */
    .concept-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px; margin-bottom:32px; }
    .concept-card { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:18px; cursor:pointer; transition:all .2s; }
    .concept-card:hover { border-color:var(--accent); transform:translateY(-2px); }
    .concept-card.selected { border-color:var(--accent); background:#1a1040; }
    .concept-title { font-weight:700; font-size:15px; margin-bottom:6px; }
    .concept-tags { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }
    .tag { background:#2a2a4a; padding:2px 8px; border-radius:4px; font-size:10px; }
    /* DDM panel */
    .ddm-panel { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:24px; margin-bottom:28px; }
    .ddm-slider-row { display:flex; align-items:center; gap:14px; margin-bottom:20px; }
    .ddm-slider-row label { font-size:13px; opacity:.7; white-space:nowrap; }
    .ddm-slider-row input[type=range] { flex:1; accent-color:var(--accent); }
    .ddm-level-names { display:flex; justify-content:space-between; font-size:10px; opacity:.4; margin-top:-12px; margin-bottom:16px; }
    .ddm-content { font-size:14px; line-height:1.75; border-left:3px solid var(--accent); padding-left:16px; min-height:80px; }
    .analogy-box { background:#0d0d22; border-radius:8px; padding:14px; margin-top:16px; font-size:13px; }
    .analogy-box b { color:#a78bfa; }
    /* Quiz */
    .quiz-section { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:24px; margin-bottom:28px; }
    .quiz-q { font-size:15px; font-weight:600; margin-bottom:16px; }
    .quiz-options { display:flex; flex-direction:column; gap:8px; }
    .quiz-opt { padding:10px 14px; border-radius:6px; border:1px solid var(--border); background:#0d0d22; cursor:pointer; font-size:13px; transition:all .2s; }
    .quiz-opt:hover { border-color:var(--accent); }
    .quiz-opt.correct { border-color:#10b981; background:#064e3b22; }
    .quiz-opt.wrong   { border-color:#ef4444; background:#7f1d1d22; }
    .quiz-feedback { margin-top:12px; font-size:13px; padding:10px; border-radius:6px; display:none; }
    .quiz-feedback.show { display:block; }
    .quiz-feedback.pass { background:#064e3b33; color:#34d399; }
    .quiz-feedback.fail { background:#7f1d1d33; color:#f87171; }
    /* Progress bar */
    .progress-bar { height:6px; background:#1e1e3f; border-radius:3px; overflow:hidden; margin-bottom:4px; }
    .progress-fill { height:100%; background:linear-gradient(90deg,#6d28d9,#22d3ee); border-radius:3px; transition:width .5s; }
    /* Misc */
    .no-concept { text-align:center; opacity:.4; padding:40px; }
    .misconception-box { border:1px solid #f59e0b44; background:#f59e0b11; border-radius:8px; padding:12px; margin-top:14px; font-size:12px; color:#fcd34d; }
  </style>
</head>
<body>
<nav class="main-nav">
  <div class="nav-container">
    <h1 class="nav-title">QuanV1</h1>
    <ul class="nav-menu">
      <li><a href="/" class="nav-link">🏠 Home</a></li>
      <li><a href="/cluster-config" class="nav-link">⚙️ Clusters</a></li>
      <li><a href="/quantum-school" class="nav-link active">🎓 School</a></li>
      <li><a href="/quantum-analyzer" class="nav-link">🔬 Analyzer</a></li>
      <li><a href="/quantum-pipeline" class="nav-link">🔗 Pipeline</a></li>
      <li><a href="/quantum-rag-vault" class="nav-link">🔐 Vault</a></li>
      <li><a href="/quantum-vortex" class="nav-link">🌀 Vortex</a></li>
        <li><a href="/nvidia-pipeline" class="nav-link">🟢 NVIDIA</a></li>
    </ul>
  </div>
</nav>

<div class="school-layout">
  <h2 style="margin-bottom:6px;">🎓 Quantum Curriculum</h2>
  <p style="opacity:.5; font-size:13px; margin-bottom:20px;">
    Q-CTRL · PennyLane · Qiskit · DDM 5-level decomposition. Progress saved locally.
  </p>

  <!-- Overall progress -->
  <div style="margin-bottom:20px;">
    <div style="display:flex; justify-content:space-between; font-size:12px; opacity:.6; margin-bottom:4px;">
      <span>Overall progress</span><span id="prog-label">0 / 0 concepts mastered</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" id="prog-fill" style="width:0%"></div></div>
  </div>

  <!-- Stage selector -->
  <div class="stages" id="stage-list"></div>

  <!-- Concept grid -->
  <div class="concept-grid" id="concept-grid">
    <div class="no-concept">Select a stage above to begin.</div>
  </div>

  <!-- DDM panel (hidden until concept selected) -->
  <div class="ddm-panel" id="ddm-panel" style="display:none;">
    <h3 id="ddm-title" style="margin:0 0 16px;"></h3>
    <div class="ddm-slider-row">
      <label>Understanding level:</label>
      <input type="range" id="ddm-slider" min="0" max="4" value="0" oninput="renderDDM(this.value)">
    </div>
    <div class="ddm-level-names">
      <span>Intuition</span><span>Analogy</span><span>Semi-formal</span><span>Formal</span><span>Mathematical</span>
    </div>
    <div class="ddm-content" id="ddm-text"></div>
    <div class="analogy-box" id="analogy-box" style="display:none;">
      <b>Classical analogy: </b><span id="analogy-text"></span>
    </div>
    <div class="misconception-box" id="misconception-box" style="display:none;">
      ⚠️ Common misconception: <span id="misconception-text"></span>
    </div>
  </div>

  <!-- Quiz section -->
  <div class="quiz-section" id="quiz-section" style="display:none;">
    <h3 style="margin:0 0 16px;">📝 Quiz</h3>
    <div class="quiz-q" id="quiz-q"></div>
    <div class="quiz-options" id="quiz-opts"></div>
    <div class="quiz-feedback" id="quiz-fb"></div>
    <button onclick="nextQuestion()" id="quiz-next-btn" style="margin-top:14px; display:none; padding:10px 22px; background:var(--accent); border:none; color:#fff; border-radius:6px; cursor:pointer; font-size:13px;">Next Question →</button>
  </div>
</div>

<script>
// ── Data ─────────────────────────────────────────────────────────────────────
let curriculum = null;
let selectedStage = null;
let selectedConcept = null;
let quizIdx = 0;
let progress = JSON.parse(localStorage.getItem('quanv1_progress') || '{}');

const DDM_KEYS = ['intuition','analogy','semi_formal','formal','mathematical'];
const DDM_LABELS = ['Intuition','Classical Analogy','Semi-formal','Formal','Mathematical'];

async function loadCurriculum() {
  const res = await fetch('/api/quantum/concepts');
  curriculum = await res.json();
  renderStages();
  updateProgress();
}

function renderStages() {
  const list = document.getElementById('stage-list');
  list.innerHTML = '';
  const stages = curriculum.stages || curriculum.pipeline_stages || [];
  stages.forEach((stage, i) => {
    const btn = document.createElement('button');
    btn.className = 'stage-btn' + (i === 0 ? ' active' : '');
    btn.textContent = `${i+1}. ${stage.name || stage.id || stage}`;
    btn.onclick = () => selectStage(stage, btn);
    list.appendChild(btn);
    if (i === 0) selectStage(stage, btn);
  });
}

function selectStage(stage, btn) {
  document.querySelectorAll('.stage-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  selectedStage = stage;
  renderConceptGrid(stage);
}

function renderConceptGrid(stage) {
  const grid = document.getElementById('concept-grid');
  grid.innerHTML = '';
  const conceptKeys = stage.concepts || [];
  if (!conceptKeys.length) {
    grid.innerHTML = '<div class="no-concept">No concepts in this stage.</div>';
    return;
  }
  conceptKeys.forEach(key => {
    const c = (curriculum.concepts || {})[key] || { title: key };
    const mastered = progress[key] === 'mastered';
    const card = document.createElement('div');
    card.className = 'concept-card' + (mastered ? ' selected' : '');
    card.innerHTML = `
      <div class="concept-title">${mastered ? '✅ ' : ''}${c.title || key}</div>
      <div style="font-size:12px; opacity:.6; margin-top:4px;">${c.short_description || c.description || ''}</div>
      <div class="concept-tags">
        ${(c.tags || [c.category || 'quantum']).map(t => `<span class="tag">${t}</span>`).join('')}
      </div>`;
    card.onclick = () => openConcept(key, c, card);
    grid.appendChild(card);
  });
}

function openConcept(key, concept, card) {
  document.querySelectorAll('.concept-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  selectedConcept = { key, concept };

  // DDM panel
  document.getElementById('ddm-panel').style.display = 'block';
  document.getElementById('ddm-title').textContent = concept.title || key;
  document.getElementById('ddm-slider').value = 0;
  renderDDM(0);

  // Quiz
  if (concept.quiz && concept.quiz.length) {
    quizIdx = 0;
    document.getElementById('quiz-section').style.display = 'block';
    renderQuestion();
  } else {
    document.getElementById('quiz-section').style.display = 'none';
  }
}

function renderDDM(levelIdx) {
  const c = selectedConcept?.concept;
  if (!c) return;
  const key = DDM_KEYS[levelIdx];
  const text = c.ddm?.[key] || c[key] || `[Level ${DDM_LABELS[levelIdx]} not yet available for this concept]`;
  document.getElementById('ddm-text').textContent = text;

  // Analogy box (always show when available)
  const analogyEl = document.getElementById('analogy-box');
  if (c.classical_analogy || c.analogy) {
    document.getElementById('analogy-text').textContent = c.classical_analogy || c.analogy;
    analogyEl.style.display = 'block';
  } else { analogyEl.style.display = 'none'; }

  // Misconception
  const miscEl = document.getElementById('misconception-box');
  if (c.misconception || c.common_mistake) {
    document.getElementById('misconception-text').textContent = c.misconception || c.common_mistake;
    miscEl.style.display = 'block';
  } else { miscEl.style.display = 'none'; }
}

// ── Quiz ──────────────────────────────────────────────────────────────────────
function renderQuestion() {
  const quiz = selectedConcept?.concept?.quiz;
  if (!quiz || quizIdx >= quiz.length) {
    // All done
    progress[selectedConcept.key] = 'mastered';
    localStorage.setItem('quanv1_progress', JSON.stringify(progress));
    updateProgress();
    document.getElementById('quiz-q').textContent = '🎉 All questions answered! Concept mastered.';
    document.getElementById('quiz-opts').innerHTML = '';
    document.getElementById('quiz-next-btn').style.display = 'none';
    return;
  }
  const q = quiz[quizIdx];
  document.getElementById('quiz-q').textContent = `Q${quizIdx+1}/${quiz.length}: ${q.question}`;
  const optsEl = document.getElementById('quiz-opts');
  optsEl.innerHTML = '';
  const opts = q.options || q.choices || [];
  opts.forEach((opt, i) => {
    const btn = document.createElement('div');
    btn.className = 'quiz-opt';
    btn.textContent = opt;
    btn.onclick = () => checkAnswer(i, q.correct_index ?? q.answer, btn, optsEl);
    optsEl.appendChild(btn);
  });
  document.getElementById('quiz-fb').className = 'quiz-feedback';
  document.getElementById('quiz-fb').textContent = '';
  document.getElementById('quiz-next-btn').style.display = 'none';
}

function checkAnswer(selected, correct, btn, optsEl) {
  document.querySelectorAll('.quiz-opt').forEach(b => b.onclick = null);
  const fbEl = document.getElementById('quiz-fb');
  if (selected === correct) {
    btn.classList.add('correct');
    fbEl.textContent = '✅ Correct! ' + (selectedConcept?.concept?.quiz?.[quizIdx]?.explanation || '');
    fbEl.className = 'quiz-feedback show pass';
  } else {
    btn.classList.add('wrong');
    optsEl.children[correct]?.classList.add('correct');
    fbEl.textContent = '❌ Incorrect. ' + (selectedConcept?.concept?.quiz?.[quizIdx]?.explanation || '');
    fbEl.className = 'quiz-feedback show fail';
  }
  document.getElementById('quiz-next-btn').style.display = 'inline-block';
}

function nextQuestion() {
  quizIdx++;
  renderQuestion();
}

function updateProgress() {
  const allConcepts = Object.keys(curriculum?.concepts || {});
  const mastered = allConcepts.filter(k => progress[k] === 'mastered').length;
  document.getElementById('prog-label').textContent = `${mastered} / ${allConcepts.length} concepts mastered`;
  document.getElementById('prog-fill').style.width = allConcepts.length
    ? (mastered / allConcepts.length * 100) + '%' : '0%';
}

loadCurriculum();
</script>
</body>
</html>
