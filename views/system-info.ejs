<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Information - QuanV1</title>
    <meta name="description" content="View system and platform information">
    <link rel="stylesheet" href="/css/main.css" type="text/css">
    <link rel="stylesheet" href="/css/pages.css" type="text/css">
  </head>
  <body>
    <!-- Navigation Bar -->
    <nav class="main-nav">
      <div class="nav-container">
        <h1 class="nav-title">QuanV1 - Arkitek Builder</h1>
        <ul class="nav-menu">
          <li><a href="/" class="nav-link" accesskey="h">🏠 Home</a></li>
          <li><a href="/cluster-config" class="nav-link" accesskey="c">⚙️ Clusters</a></li>
          <li><a href="/ipxe-boot" class="nav-link" accesskey="b">🚀 Boot Generator</a></li>
          <li><a href="/system-info" class="nav-link active" accesskey="s">💻 System Info</a></li>
                  <li><a href="/quantum-school" class="nav-link">🎓 School</a></li>
          <li><a href="/quantum-analyzer" class="nav-link">🔬 Analyzer</a></li>
          <li><a href="/quantum-pipeline" class="nav-link">🔗 Pipeline</a></li>
          <li><a href="/quantum-rag-vault" class="nav-link">🔐 Vault</a></li>
          <li><a href="/quantum-vortex" class="nav-link">🌀 Vortex</a></li>
        <li><a href="/nvidia-pipeline" class="nav-link">🟢 NVIDIA</a></li>
        <li><a href="/bananas" class="nav-link nav-banana">🍌 Bananas AI</a></li>
</ul>
      </div>
    </nav>

    <div class="container">
      <h1>💻 System Information</h1>
      <p class="subtitle">Cross-platform compatibility details and system status</p>
      
      <div class="info-box">
        <h3>🌐 Platform Compatibility</h3>
        <p>This application is designed to run on Windows, macOS, and Linux with full cross-platform support.</p>
      </div>

      <div id="systemInfoContent" class="system-info-grid">
        <div class="info-card">
          <h3>⚙️ Loading System Information...</h3>
          <p>Please wait while we fetch the system details.</p>
        </div>
      </div>

      <div class="info-box" style="margin-top: 30px;">
        <h3>📚 Documentation</h3>
        <p>For detailed platform-specific instructions and troubleshooting, see the <a href="https://github.com/NaTo1000/QuanV1/blob/main/PLATFORM_SUPPORT.md" target="_blank" rel="noopener noreferrer" style="color: #667eea; font-weight: bold;">Platform Support Guide</a>.</p>
      </div>
    </div>

    <script>
      // Fetch system information from API
      async function loadSystemInfo() {
        try {
          const response = await fetch('/api/system-info');
          const data = await response.json();
          
          const content = document.getElementById('systemInfoContent');
          content.innerHTML = `
            <div class="info-card">
              <h3>🖥️ Operating System</h3>
              <p><strong>Platform:</strong> ${data.platform}</p>
              <p><strong>Type:</strong> ${data.type}</p>
              <p><strong>Release:</strong> ${data.release}</p>
              <p><strong>Architecture:</strong> ${data.architecture}</p>
              <p><strong>Hostname:</strong> ${data.hostname}</p>
            </div>

            <div class="info-card">
              <h3>⚡ Node.js Runtime</h3>
              <p><strong>Version:</strong> ${data.nodeVersion}</p>
              <p><strong>Path Separator:</strong> <code>${data.pathSeparator}</code></p>
              <p><strong>Line Endings:</strong> ${data.lineEnding}</p>
            </div>

            <div class="info-card">
              <h3>💾 Memory</h3>
              <p><strong>Total:</strong> ${formatBytes(data.totalMemory)}</p>
              <p><strong>Free:</strong> ${formatBytes(data.freeMemory)}</p>
              <p><strong>Used:</strong> ${formatBytes(data.totalMemory - data.freeMemory)}</p>
              <div class="memory-bar">
                <div class="memory-used" style="width: ${((data.totalMemory - data.freeMemory) / data.totalMemory * 100).toFixed(1)}%"></div>
              </div>
              <p style="text-align: center; font-size: 12px; margin-top: 5px;">
                ${((data.totalMemory - data.freeMemory) / data.totalMemory * 100).toFixed(1)}% used
              </p>
            </div>

            <div class="info-card">
              <h3>🔧 Hardware</h3>
              <p><strong>CPU Cores:</strong> ${data.cpus}</p>
              <p><strong>System Uptime:</strong> ${formatUptime(data.uptime)}</p>
            </div>

            <div class="info-card">
              <h3>🌐 Network Interfaces</h3>
              <ul style="margin: 0; padding-left: 20px;">
                ${data.networkInterfaces.map(iface => `<li>${iface}</li>`).join('')}
              </ul>
            </div>

            <div class="info-card compatibility-status">
              <h3>✅ Compatibility Status</h3>
              <p><strong>Platform Support:</strong> <span class="status-badge status-active">Fully Supported</span></p>
              <p><strong>File Paths:</strong> <span style="color: #28a745;">✓ Cross-platform</span></p>
              <p><strong>Line Endings:</strong> <span style="color: #28a745;">✓ Auto-detected</span></p>
              <p><strong>Process Signals:</strong> <span style="color: #28a745;">✓ Supported</span></p>
            </div>
          `;
        } catch (error) {
          const content = document.getElementById('systemInfoContent');
          const msg = document.createElement('p');
          msg.style.color = '#d73a49';
          msg.textContent = 'Failed to fetch system information: ' + error.message;
          const card = document.createElement('div');
          card.className = 'info-card';
          card.style.borderColor = '#d73a49';
          const heading = document.createElement('h3');
          heading.textContent = '❌ Error Loading System Information';
          const btn = document.createElement('button');
          btn.style.marginTop = '10px';
          btn.textContent = 'Retry';
          btn.onclick = loadSystemInfo;
          card.appendChild(heading);
          card.appendChild(msg);
          card.appendChild(btn);
          content.innerHTML = '';
          content.appendChild(card);
        }
      }

      function formatBytes(bytes) {
        const gb = bytes / (1024 * 1024 * 1024);
        if (gb >= 1) {
          return gb.toFixed(2) + ' GB';
        }
        const mb = bytes / (1024 * 1024);
        return mb.toFixed(2) + ' MB';
      }

      function formatUptime(seconds) {
        const days = Math.floor(seconds / 86400);
        const hours = Math.floor((seconds % 86400) / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        
        if (days > 0) {
          return `${days}d ${hours}h ${minutes}m`;
        } else if (hours > 0) {
          return `${hours}h ${minutes}m`;
        } else {
          return `${minutes}m`;
        }
      }

      // Load system info on page load
      loadSystemInfo();

      // Refresh every 30 seconds
      setInterval(loadSystemInfo, 30000);
    </script>

    <style>
      .system-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 30px;
      }

      .info-card {
        background: white;
        border: 1px solid #e1e4e8;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .info-card h3 {
        margin-top: 0;
        color: #333;
        border-bottom: 2px solid #667eea;
        padding-bottom: 10px;
      }

      .info-card p {
        margin: 10px 0;
        color: #666;
      }

      .info-card code {
        background: #f6f8fa;
        padding: 2px 6px;
        border-radius: 3px;
        font-family: 'Courier New', monospace;
      }

      .memory-bar {
        width: 100%;
        height: 20px;
        background: #e1e4e8;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 10px;
      }

      .memory-used {
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        transition: width 0.3s ease;
      }

      .compatibility-status {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        border-color: #28a745;
      }
    </style>
  </body>
</html>
