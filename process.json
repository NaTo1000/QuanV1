{
  "apps": [
    {
      "name": "quanv1-app",
      "script": "./index.js",
      "instances": 1,
      "exec_mode": "fork",
      "watch": true,
      "watch_delay": 1000,
      "ignore_watch": [
        "node_modules",
        "cluster-links.json",
        "*.log"
      ],
      "watch_options": {
        "followSymlinks": true,
        "usePolling": true,
        "interval": 5
      },
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "error_file": "./logs/error.log",
      "out_file": "./logs/out.log",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "env_development": {
        "NODE_ENV": "development",
        "PORT": 3000
      }
    }
  ]
}
